{
  "manifest_version": 3,
  "name": "ChatGPT Conversation Search",
  "version": "0.1.0",
  "description": "Fast local title search for ChatGPT conversations.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://chatgpt.com/*"],
  "background": {
    "service_worker": "dist/serviceWorker.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChatGPT Conversation Search",
    "default_popup": "dist/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["dist/contentScript.js"],
      "css": [
        "dist/content/styles/base.css",
        "dist/content/styles/entry.css",
        "dist/content/styles/modal.css",
        "dist/content/styles/results.css",
        "dist/content/styles/help.css",
        "dist/content/styles/sync.css",
        "dist/content/styles/toast.css",
        "dist/content/styles/responsive.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open ChatGPT conversation search"
    }
  }
}
