    "package": "./scripts/package-extension.sh"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
